# Environment contract for ebook-reader (single file, repo root).
# Copy to `.env` and fill EVERY variable — both apps validate on startup and
# refuse to run if any of these are missing or malformed.

# --- Web (Vite) -----------------------------------------------------------
# Must be prefixed VITE_ to be exposed to the client. Loaded from this root
# file via Vite's envDir (see apps/web/vite.config.ts).
# May include a path prefix (e.g. http://host/atrium-api) when the API sits
# behind a reverse proxy — apiUrl() in api-client.ts preserves it.
VITE_API_URL=http://localhost:3001

# --- API (Fastify) --------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# Note: there is no platform password. Access is gated by per-user accounts
# stored in the database and created by the operator seed
# (apps/api/scripts/seed.ts — copy from seed.example.ts, then
# `npm run seed -w @ebook-reader/api`). No self-registration.

MAX_UPLOAD_MB=50
CONVERT_TIMEOUT_MS=60000

# Ceiling on a library conversion job (brief 34 / D34), in milliseconds.
# 24 hours. That is a last-resort reaper, not a UX guard: nobody waits at the
# screen for a conversion — the book's row says "running", the client polls, and
# the person walks away. This number exists only so a wedged `ebook-convert`
# can't pin a CPU forever. The answer to "this is taking too long" is the Cancel
# button, not a shorter ceiling.
CONVERT_JOB_TIMEOUT_MS=86400000

# Optional (brief 22): base URL of the Gutendex instance the catalog proxy
# queries. Defaults to the public community instance when unset; override to
# point at a self-hosted mirror. Not required — leave unset for normal use.
# GUTENDEX_BASE_URL=https://gutendex.com
