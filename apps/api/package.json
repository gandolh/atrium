{
  "name": "@ebook-reader/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed:user": "tsx src/scripts/seed-user.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --import ./test/setup.ts --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@ebook-reader/shared": "*",
    "@ebook-reader/typeset": "*",
    "@fastify/multipart": "10.0.0",
    "adm-zip": "0.6.1",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "knex": "3.1.0",
    "music-metadata": "11.14.0",
    "pdf-lib": "1.17.1",
    "pdf-to-img": "6.2.0",
    "perfect-freehand": "1.2.3",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.1",
    "tsx": "4.22.5",
    "typescript": "5.9.3"
  }
}
