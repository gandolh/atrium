  "cards": [
    {
      "dot": "cyan",
      "title": "Four workspaces",
      "items": [
        "apps/web — React, the Reading Room language, an installable PWA",
        "apps/api — Fastify + Knex, six domain modules, one app-wide guard",
        "packages/shared — the contracts web and api both compile against",
        "packages/typeset — a LaTeX-subset compiler written here, in TypeScript"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two kinds of storage",
      "items": [
        "SQLite holds metadata; the bytes are files on disk",
        "So a database dump alone is not a backup of atrium",
        "Progress, notes and preferences are profile-scoped in SQL, not after"
      ]
    },
    {
      "dot": "rose",
      "title": "What the Ward cutover removed",
      "items": [
        "No users table, no sessions table, no password hashes",
        "profiles carries an opaque subject and no foreign key to anything",
        "Referential integrity for the subject is Ward's, not atrium's"
      ]
    }
  ]
