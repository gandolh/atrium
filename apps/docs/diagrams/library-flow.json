          "extract",
          "blobs",
          "reader"
        ],
        "note": "A file is validated, has its metadata and cover pulled out, and becomes a library row."
      },
      {
        "id": "convert",
        "label": "Conversion",
        "focus": [
          "rows",
          "calibre",
          "versions"
        ],
        "note": "Calibre produces a LINKED row, never a replacement — both formats stay in the library."
      },
      {
        "id": "scoped",
        "label": "What is per-profile",
        "focus": [
          "rows",
          "progress",
          "reader"
        ],
        "note": "The library is shared; only progress, notes and preferences are profile-scoped."
      }
    ]
  },
