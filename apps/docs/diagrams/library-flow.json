  "cards": [
    {
      "dot": "emerald",
      "title": "The main path",
      "items": [
        "A file is checked before anything derives from it — a truncated upload is a 413, not a half-row",
        "Metadata and cover are extracted once, at ingest, not on every read",
        "The bytes go to disk and the row points at them; the database is metadata only"
      ]
    },
    {
      "dot": "amber",
      "title": "Conversion branches, it does not replace",
      "items": [
        "Calibre runs asynchronously and can be cancelled mid-job",
        "The output is a LINKED library row, so both formats stay readable",
        "document_versions is the same mechanism published LaTeX output uses"
      ]
    },
    {
      "dot": "rose",
      "title": "What a profile actually scopes",
      "items": [
        "The media library is SHARED across profiles — this is deliberate",
        "Progress, notes, LaTeX projects and preferences are scoped",
        "Scoping is applied in SQL, never as a filter over rows already fetched"
      ]
    }
  ]
}
