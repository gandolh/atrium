{
  "name": "atrium",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/typeset",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @ebook-reader/shared && npm run build -w @ebook-reader/typeset",
    "dev": "npm run build:packages && concurrently -n web,api,typeset -c cyan,magenta,yellow \"npm run dev -w @ebook-reader/web\" \"npm run dev -w @ebook-reader/api\" \"tsc --watch --preserveWatchOutput -p packages/typeset/tsconfig.json\"",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build:packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:packages",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "concurrently": "9.2.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": ">=24"
  }
}
