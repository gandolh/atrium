{
  "name": "atrium",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/typeset",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @ebook-reader/shared && npm run build -w @ebook-reader/typeset",
    "dev": "npm run build:packages && concurrently -n web,api,typeset -c cyan,magenta,yellow \"npm run dev -w @ebook-reader/web\" \"npm run dev -w @ebook-reader/api\" \"tsc --watch --preserveWatchOutput -p packages/typeset/tsconfig.json\"",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build:packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:packages",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": ">=24"
  }
}
